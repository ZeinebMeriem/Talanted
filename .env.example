# ╔══════════════════════════════════════════════════════════════════════╗
# ║  AI UI Generator — Local Setup                                      ║
# ║  Copy this file:  cp .env.example .env                             ║
# ║  Fill in your API keys, then run: docker compose up -d             ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── Public hostname (localhost for local dev) ───────────────────────────
PUBLIC_HOSTNAME=localhost

# ══════════════════════════════════════════════════════════════════════
# INFRASTRUCTURE (no change needed for local dev)
# ══════════════════════════════════════════════════════════════════════

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=ai-ui-files

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ── Dev login credentials (already seeded in Keycloak) ─────────────────
#   Standard user → email: developpeur@example.com  / password: developpeur
#   Admin user    → email: admin@aiuigenerator.com   / password: Admin@1234

# ══════════════════════════════════════════════════════════════════════
# FRONTEND (Vite) — also paste these into frontend/.env.local
# ══════════════════════════════════════════════════════════════════════

VITE_API_BASE_URL=http://localhost:8081
VITE_BFF_BASE_URL=http://localhost:8081
VITE_OIDC_AUTHORITY=http://localhost:8083/realms/ai-ui
VITE_OIDC_CLIENT_ID=ai-ui-frontend
VITE_OIDC_REDIRECT_URI=http://localhost:5173/

# ══════════════════════════════════════════════════════════════════════
# AI PROVIDERS — add at least one key to generate UIs
# ══════════════════════════════════════════════════════════════════════

PLANNER_PROVIDER=gemini
CODER_PROVIDER=gemini
VISION_PROVIDER=gemini
NO_LOCAL_MODEL=true
PLANNER_MAX_TOKENS=1200
CODER_MAX_TOKENS=8192

# Google Gemini — FREE tier (recommended): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_RPM=12
GEMINI_MAX_RETRIES=6
GEMINI_RETRY_MAX_WAIT_S=300

# Groq — FREE tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Cohere (optional)
COHERE_API_KEY=

# Kimi / Azure OpenAI (optional)
KIMI_API_KEY=
KIMI_BASE_URL=
KIMI_MODEL=Kimi-K2.6

# Ollama local (optional fallback, no key needed)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:3b

# ══════════════════════════════════════════════════════════════════════
# OPTIONAL INTEGRATIONS
# ══════════════════════════════════════════════════════════════════════

# Jira — https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_FRONTEND_LABELS=ui,interface,ux

# ElevenLabs — speech to requirements
ELEVENLABS_API_KEY=
TRANSCRIPT_LANGUAGE=en
QWEN_MODEL=qwen2.5:3b

# Pexels images (falls back to Lorem Picsum if empty)
PEXELS_API_KEY=

# Email / SMTP — use Mailtrap sandbox for dev: https://mailtrap.io
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@ai-ui-generator.local
GMAIL_APP_PASSWORD=
SMTP_PASSWORD=

# Slack alerts (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

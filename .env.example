# ╔══════════════════════════════════════════════════════════════════════╗
# ║  AI UI Generator — Environment Variables                            ║
# ║  Copy this file to .env and fill in your values.                    ║
# ║  ⚠ NEVER commit .env — it contains real secrets.                    ║
# ║  Use PLANNER_PROVIDER / CODER_PROVIDER to mix different APIs.       ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── Per-role provider selection (groq|gemini|openai|ollama) ─────────────
# If not set, auto-detects from available API keys.
# If you do NOT want any local model fallback, set these explicitly.
PLANNER_PROVIDER=gemini
CODER_PROVIDER=gemini
# If true, never fall back to local Ollama models
NO_LOCAL_MODEL=true
# Vision/OCR provider for mockups (optional; auto-detected from keys if unset)
VISION_PROVIDER=gemini

# ── Groq (blazing fast, free tier: 30 RPM) ─────────────────────────────
# Get your key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_PLANNER_MODEL=llama-3.3-70b-versatile
# GROQ_CODER_MODEL=llama-3.3-70b-versatile

# ── Google Gemini (free tier: 15 RPM, 1M tokens/day) ───────────────────
# Get your key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_PLANNER_MODEL=gemini-2.0-flash
# GEMINI_CODER_MODEL=gemini-2.0-flash
# Optional 429 mitigation (useful for multi-file generations)
GEMINI_RPM=12
GEMINI_MAX_RETRIES=6
GEMINI_RETRY_MAX_WAIT_S=300

# ── Jira (Atlassian Cloud) ───────────────────────────────────────────────
# Your Jira base url (ex: https://mycompany.atlassian.net)
JIRA_BASE_URL=
# The email used to log in to Jira
JIRA_EMAIL=
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Which labels define "frontend tasks" to list from a project/board URL
JIRA_FRONTEND_LABELS=ui,interface,ux

# ── Generic OpenAI-compatible (OpenAI, OpenRouter, Together, etc.) ──────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# OPENAI_PLANNER_MODEL=gpt-4o-mini
# OPENAI_CODER_MODEL=gpt-4o

# ── Token limits ────────────────────────────────────────────────────────
PLANNER_MAX_TOKENS=1200
CODER_MAX_TOKENS=8192

# ── Pexels (free image API for themed images, 200 req/hour) ─────────────
# Get your key: https://www.pexels.com/api/new/
# If empty, falls back to Lorem Picsum (random photos, no key needed)
PEXELS_API_KEY=

# ── Local Ollama (automatic fallback, no key needed) ────────────────────
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_CODER_MODEL=qwen2.5-coder:latest

# ── Infrastructure (dev-only defaults — change for production) ──────────
# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=ai-ui-files

# --- Keycloak (OIDC) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Keycloak SMTP (Gmail App Password for email verification & forgot password) ---
SMTP_PASSWORD=your_16char_app_password_here
# ╔══════════════════════════════════════════════════════════════════════╗
# ║  AI UI Generator — Local Development Environment                    ║
# ║  Copy this file to .env  →  cp .env.example .env                   ║
# ║  All values below work out-of-the-box for local Docker Compose.     ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── Hostname (leave as localhost for local dev) ─────────────────────────
PUBLIC_HOSTNAME=localhost

# ══════════════════════════════════════════════════════════════════════
# INFRASTRUCTURE — Docker services (no change needed for local dev)
# ══════════════════════════════════════════════════════════════════════

# --- MongoDB ---
MONGO_URI=mongodb://mongo:27017/ai_ui_generator

# --- MinIO (S3-compatible file storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=ai-ui-files

# --- Keycloak (Identity & Auth) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Dev users (auto-imported from keycloak/realm-ai-ui.json):
#   Standard user → email: developpeur@example.com  password: developpeur
#   Admin user    → email: admin@aiuigenerator.com   password: Admin@1234

# ══════════════════════════════════════════════════════════════════════
# FRONTEND — Vite / React (also copy these into frontend/.env.local)
# ══════════════════════════════════════════════════════════════════════
VITE_API_BASE_URL=http://localhost:8081
VITE_BFF_BASE_URL=http://localhost:8081
VITE_OIDC_AUTHORITY=http://localhost:8083/realms/ai-ui
VITE_OIDC_CLIENT_ID=ai-ui-frontend
VITE_OIDC_REDIRECT_URI=http://localhost:5173/

# ══════════════════════════════════════════════════════════════════════
# AI PROVIDERS — at least one key is required to generate UIs
# ══════════════════════════════════════════════════════════════════════

# Provider routing (gemini | groq | openai | ollama)
PLANNER_PROVIDER=gemini
CODER_PROVIDER=gemini
VISION_PROVIDER=gemini
NO_LOCAL_MODEL=true

# Token limits
PLANNER_MAX_TOKENS=1200
CODER_MAX_TOKENS=8192

# --- Google Gemini (recommended — free tier: 15 RPM, 1M tokens/day) ---
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_RPM=12
GEMINI_MAX_RETRIES=6
GEMINI_RETRY_MAX_WAIT_S=300

# --- Groq (fast, free tier: 30 RPM) ---
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenAI (or any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Cohere ---
COHERE_API_KEY=

# --- Kimi / Azure OpenAI (optional) ---
KIMI_API_KEY=
KIMI_BASE_URL=
KIMI_MODEL=Kimi-K2.6

# --- Local Ollama (optional fallback, no key needed) ---
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_CODER_MODEL=qwen2.5-coder:latest

# ══════════════════════════════════════════════════════════════════════
# OPTIONAL INTEGRATIONS
# ══════════════════════════════════════════════════════════════════════

# --- Jira (to import tasks as UI requirements) ---
# JIRA_BASE_URL=https://yourcompany.atlassian.net
# JIRA_EMAIL=your@email.com
# JIRA_API_TOKEN=     # https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_FRONTEND_LABELS=ui,interface,ux

# --- Pexels (themed images in generated UIs — falls back to Lorem Picsum if empty) ---
# Get key: https://www.pexels.com/api/new/
PEXELS_API_KEY=

# --- ElevenLabs (speech-to-requirements / transcript AI) ---
ELEVENLABS_API_KEY=
TRANSCRIPT_LANGUAGE=en
QWEN_MODEL=qwen2.5:3b

# --- Email / SMTP (for account verification & password reset) ---
# Using Mailtrap for dev: https://mailtrap.io (free sandbox)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@ai-ui-generator.local
# Gmail App Password alternative (Settings → Security → App Passwords)
GMAIL_APP_PASSWORD=
SMTP_PASSWORD=

# --- Slack alerts (optional) ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK